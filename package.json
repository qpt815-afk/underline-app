{
  "name": "underline-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "sync-font": "cp node_modules/@fontsource/noto-serif-kr/files/noto-serif-kr-korean-400-normal.woff2 public/fonts/noto-serif-kr-korean-400.woff2 && cp node_modules/@fontsource/noto-serif-kr/LICENSE public/fonts/LICENSE.txt",
    "generate-icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@fontsource/noto-serif-kr": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "7.4.1"
  }
}
