# ─────────────────────────────────────────────────────────────────────────────
# 밑줄 환경변수
#
# 이 파일은 예시입니다. 실제 값은 절대 커밋하지 마세요.
# 값은 Vercel 대시보드 > 프로젝트 > Settings > Environment Variables 에 넣습니다.
#
# ⚠️ VITE_ 로 시작하는 변수는 빌드 시점에 클라이언트 번들에 그대로 박힙니다.
#    누구나 볼 수 있으므로 공개해도 되는 값만 넣으세요.
#    VITE_ 가 없는 변수는 서버리스 함수에서만 읽히고 클라이언트에 노출되지 않습니다.
#
# ⚠️ 어떤 변수든 넣거나 바꾼 뒤에는 Redeploy 해야 반영됩니다.
#    VITE_ 변수는 빌드에 박히고, 나머지도 배포 시점의 스냅샷을 씁니다.
#
# ⚠️ Vercel 에서 변수 타입: VITE_ 로 시작하면 Config, 나머지는 Secret.
#    VITE_ 를 Secret 으로 만들면 저장이 거부되고, 타입은 나중에 못 바꿉니다(삭제 후 재생성).
#    Secret 은 빈 값과 채운 값이 구분되지 않으니, 앱의 자가 진단으로 확인하세요.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Phase 1부터 필요) ───────────────────────────────────────────────
# Supabase 대시보드 > 프로젝트 > Settings > API 에서 확인합니다.
# 아래 둘은 공개되어도 안전한 값입니다. 실제 보호는 RLS(행 수준 보안)가 합니다.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ── OCR (Phase 1부터 필요) ───────────────────────────────────────────────────
# 사진에서 문장을 뽑는 공급자를 고릅니다: gemini | claude
# gemini  = 무료(하루 1,500회). 단, 무료 티어는 입력이 구글 모델 학습에 쓰입니다.
# claude  = 유료(장당 약 $0.015~0.037). 학습에 쓰이지 않습니다.
OCR_PROVIDER=gemini

# OCR_PROVIDER=gemini 일 때 필요합니다.
# https://aistudio.google.com > Get API key (신용카드 등록 불필요)
GEMINI_API_KEY=

# 기본 모델. 비우면 gemini-3.8-flash.
# 모델 ID 는 타입 검사가 되지 않으므로, 404(bad-model)가 뜨면 여기서 바꿉니다. 재빌드 불필요.
GEMINI_MODEL=

# 기본 모델이 bad-model / overloaded / upstream 으로 실패했을 때 한 번 더 시도할 모델.
# 비우면 gemini-3.5-flash-lite. 키 문제·한도 초과·타임아웃은 재시도하지 않습니다.
GEMINI_FALLBACK_MODEL=

# OCR_PROVIDER=claude 일 때 필요합니다.
# https://console.anthropic.com > API Keys
ANTHROPIC_API_KEY=

# ── 웹 푸시 (Phase 3) ────────────────────────────────────────────────────────
# 매일 아침 8시(KST) "오늘의 문장" 알림. 아래 5개가 모두 있어야 동작합니다.
#
# VAPID 키 쌍: 배포된 앱의 /diagnose 화면 맨 아래 "키 만들기" 로 폰에서 만듭니다.
# (터미널이 있다면 `npx web-push generate-vapid-keys` 도 같은 형식입니다.)
# 한 번 넣은 뒤 바꾸지 마세요 — 바꾸면 사용자들이 켜 둔 알림이 전부 풀립니다.
# 공개키는 VITE_ 라 번들에 박히므로 재배포가 필요합니다.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 푸시 서비스가 문제 시 연락할 주소. mailto: 로 시작하는 본인 이메일이면 됩니다.
VAPID_SUBJECT=mailto:you@example.com

# Vercel Cron 이 /api/push 를 부를 때 붙이는 공유 비밀. 아무 긴 무작위 문자열이면 됩니다.
# (예: 비밀번호 생성기로 32자 이상.) Vercel 이 이 변수를 보고 자동으로 헤더에 넣어 줍니다.
CRON_SECRET=

# Cron 이 모든 사용자의 구독을 읽어야 하므로 RLS 를 건너뛰는 secret key 가 필요합니다.
# Supabase 대시보드 > Settings > API keys > Secret keys 에서 만듭니다(sb_secret_ 로 시작).
# ⚠️ 절대 VITE_ 를 붙이지 마세요. 붙이는 순간 번들에 박혀 누구나 모든 데이터를 읽습니다.
SUPABASE_SECRET_KEY=
